<Window x:Class="BMI_Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BMI_Calculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label x:Name="HeightLabel" Content="Height (cm):" HorizontalAlignment="Center" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="HeightTextBox" HorizontalAlignment="Center" Margin="10,40,0,0" VerticalAlignment="Top" Width="120"/>

        <Label x:Name="WeightLabel" Content="Weight (kg):" HorizontalAlignment="Center" Margin="10,80,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="WeightTextBox" HorizontalAlignment="Center" Margin="10,110,0,0" VerticalAlignment="Top" Width="120"/>

        <Label x:Name="ResultLabel" Content="BMI: -" HorizontalAlignment="Center" Margin="10,150,0,0" VerticalAlignment="Top"/>
        
        <Button x:Name="CalculateButton" Content="Calculate BMI" HorizontalAlignment="Center" Margin="10,190,0,0" VerticalAlignment="Top" Click="CalculateButtonClick"/>
        <Button x:Name="ResetButton" Content="Reset" HorizontalAlignment="Center" Margin="10,230,0,0" VerticalAlignment="Top" Click="ResetButtonClick"/> 
        

    </Grid>
</Window>
